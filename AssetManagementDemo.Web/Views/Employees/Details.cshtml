@model AssetManagementDemo.Web.Models.Employee
@{
    ViewData["Title"] = "Employee Details";
    var assignments = ViewBag.Assignments as IEnumerable<AssetManagementDemo.Web.Models.AssetAssignment> ?? new List<AssetManagementDemo.Web.Models.AssetAssignment>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Employee Profile</h3>
        <p class="text-muted mb-0">Detailed view for @Model.EmployeeName (@Model.EmployeeCode)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-outline-primary">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Info Card -->
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 fs-2 fw-bold text-center" style="width:64px; height:64px; line-height:36px;">
                    @Model.EmployeeName.Substring(0, 1)
                </div>
                <div>
                    <h4 class="fw-bold mb-1">@Model.EmployeeName</h4>
                    <span class="badge bg-light text-dark border me-2">@Model.Department</span>
                    <span class="badge bg-success-subtle text-success">@Model.Status</span>
                </div>
            </div>

            <table class="table table-sm table-borderless">
                <tr>
                    <td class="text-muted fw-semibold" style="width: 130px;">Employee Code:</td>
                    <td class="fw-bold">@Model.EmployeeCode</td>
                </tr>
                <tr>
                    <td class="text-muted fw-semibold">Designation:</td>
                    <td>@(Model.Designation ?? "-")</td>
                </tr>
                <tr>
                    <td class="text-muted fw-semibold">Email:</td>
                    <td>@(Model.Email ?? "-")</td>
                </tr>
                <tr>
                    <td class="text-muted fw-semibold">Phone:</td>
                    <td>@(Model.Phone ?? "-")</td>
                </tr>
                <tr>
                    <td class="text-muted fw-semibold">Location:</td>
                    <td>@(Model.Location ?? "-")</td>
                </tr>
                <tr>
                    <td class="text-muted fw-semibold">Joining Date:</td>
                    <td>@(Model.JoiningDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- Assigned Assets History -->
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Assigned Equipment History</h5>
                <a asp-controller="Assignments" asp-action="Assign" asp-route-employeeId="@Model.EmployeeId" class="btn btn-sm btn-primary-custom">
                    <i class="bi bi-plus me-1"></i> Assign New Asset
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Asset</th>
                            <th>Assigned Date</th>
                            <th>Return Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!assignments.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted small">
                                    No assets have been assigned to this employee yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in assignments)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@item.Asset?.AssetName</div>
                                        <small class="text-muted">Code: @item.Asset?.AssetCode</small>
                                    </td>
                                    <td>@item.AssignedDate.ToString("yyyy-MM-dd")</td>
                                    <td>@(item.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    <td>
                                        @if (item.IsActive == true)
                                        {
                                            <span class="badge bg-success">Currently Holding</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Returned</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
