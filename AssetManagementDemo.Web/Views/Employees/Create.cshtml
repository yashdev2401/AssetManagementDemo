@model AssetManagementDemo.Web.ViewModels.EmployeeCreateViewModel
@{
    ViewData["Title"] = "Create Employee";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1">Add New Employee</h3>
                <p class="text-muted mb-0">Enter employee profile details</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label asp-for="EmployeeCode" class="form-label fw-semibold"></label>
                        <input asp-for="EmployeeCode" class="form-control" placeholder="e.g. EMP006" />
                        <span asp-validation-for="EmployeeCode" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="EmployeeName" class="form-label fw-semibold"></label>
                        <input asp-for="EmployeeName" class="form-control" placeholder="Full Name" />
                        <span asp-validation-for="EmployeeName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Department" class="form-label fw-semibold"></label>
                        <select asp-for="Department" class="form-select">
                            <option value="">-- Select Department --</option>
                            <option value="IT">IT</option>
                            <option value="HR">HR</option>
                            <option value="Finance">Finance</option>
                            <option value="Operations">Operations</option>
                            <option value="Sales">Sales</option>
                            <option value="Marketing">Marketing</option>
                        </select>
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Designation" class="form-label fw-semibold"></label>
                        <input asp-for="Designation" class="form-control" placeholder="e.g. Senior Software Engineer" />
                        <span asp-validation-for="Designation" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@company.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" placeholder="+1 234 567 890" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Location" class="form-label fw-semibold"></label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. New York / Remote" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="JoiningDate" class="form-label fw-semibold"></label>
                        <input asp-for="JoiningDate" type="date" class="form-control" />
                        <span asp-validation-for="JoiningDate" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom px-4"><i class="bi bi-save me-1"></i> Save Employee</button>
                </div>
            </form>
        </div>
    </div>
</div>
