@model AssetManagementDemo.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Executive Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">Asset Management Dashboard</h2>
        <p class="text-muted mb-0">Real-time enterprise metrics & inventory summary</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Assignments" asp-action="Assign" class="btn btn-primary-custom">
            <i class="bi bi-plus-circle me-1"></i> Assign Asset
        </a>
        <a asp-controller="Assets" asp-action="Create" class="btn btn-outline-secondary rounded-2">
            <i class="bi bi-laptop me-1"></i> New Asset
        </a>
    </div>
</div>

<!-- Stat Metric Cards Row -->
<div class="row g-4 mb-5">
    <!-- Total Employees -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small text-uppercase">Total Employees</span>
                    <h2 class="fw-bold text-dark mt-2 mb-0">@Model.TotalEmployees</h2>
                </div>
                <div class="card-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top">
                <a asp-controller="Employees" asp-action="Index" class="text-decoration-none small fw-semibold text-primary">
                    Manage Employees <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Total Assets -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small text-uppercase">Total Assets</span>
                    <h2 class="fw-bold text-dark mt-2 mb-0">@Model.TotalAssets</h2>
                </div>
                <div class="card-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-laptop-fill"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top">
                <a asp-controller="Assets" asp-action="Index" class="text-decoration-none small fw-semibold text-info">
                    View Asset Inventory <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Assigned Assets -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small text-uppercase">Assigned Assets</span>
                    <h2 class="fw-bold text-success mt-2 mb-0">@Model.AssignedAssets</h2>
                </div>
                <div class="card-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-person-check-fill"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top">
                <a asp-controller="Assignments" asp-action="Index" class="text-decoration-none small fw-semibold text-success">
                    Active Assignments <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Available Assets -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small text-uppercase">Available Assets</span>
                    <h2 class="fw-bold text-primary mt-2 mb-0">@Model.AvailableAssets</h2>
                </div>
                <div class="card-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top">
                <a asp-controller="Assets" asp-action="Index" asp-route-status="Available" class="text-decoration-none small fw-semibold text-warning">
                    Filter Available <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Secondary Row: Under Repair & Quick Actions -->
<div class="row g-4 mb-5">
    <!-- Assets Under Repair & Retired Card -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
            <h5 class="fw-bold mb-3 text-dark">Asset Maintenance & Status Overview</h5>
            <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <span class="p-3 bg-danger bg-opacity-10 text-danger rounded-3"><i class="bi bi-tools fs-4"></i></span>
                    <div>
                        <h6 class="fw-bold mb-0">Assets Under Repair</h6>
                        <small class="text-muted">Equipment currently undergoing maintenance</small>
                    </div>
                </div>
                <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill">@Model.UnderRepairAssets</span>
            </div>
            <div class="d-flex justify-content-between align-items-center py-3">
                <div class="d-flex align-items-center gap-3">
                    <span class="p-3 bg-secondary bg-opacity-10 text-secondary rounded-3"><i class="bi bi-archive-fill fs-4"></i></span>
                    <div>
                        <h6 class="fw-bold mb-0">Retired / Decommissioned</h6>
                        <small class="text-muted">Assets out of service or disposed</small>
                    </div>
                </div>
                <span class="badge bg-secondary fs-6 px-3 py-2 rounded-pill">@Model.RetiredAssets</span>
            </div>
        </div>
    </div>

    <!-- Quick Navigation & Enterprise Specs -->
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
            <h5 class="fw-bold mb-3 text-dark">Architecture & System Status</h5>
            <p class="text-muted small">
                Built with <strong>ASP.NET Core MVC (.NET 8)</strong>, <strong>Entity Framework Core</strong>, and <strong>SQL Server</strong>.
                Includes decoupled <strong>REST API Controllers</strong> formatted for clean enterprise integration.
            </p>
            <div class="d-flex flex-wrap gap-2 mt-auto">
                <a href="/swagger" target="_blank" class="btn btn-dark text-white rounded-3 px-3 py-2">
                    <i class="bi bi-code-square me-1"></i> Swagger API Documentation
                </a>
                <a asp-controller="Employees" asp-action="Create" class="btn btn-outline-primary rounded-3 px-3 py-2">
                    <i class="bi bi-person-plus me-1"></i> Add Employee
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity Tables Row -->
<div class="row g-4">
    <!-- Recently Assigned Assets -->
    <div class="col-12 col-xl-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-person-check me-2 text-success"></i>Recently Assigned Assets</h5>
                <a asp-controller="Assignments" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill px-3">View All</a>
            </div>
            @if (Model.RecentlyAssignedAssets != null && Model.RecentlyAssignedAssets.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Asset</th>
                                <th>Assigned To</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.RecentlyAssignedAssets)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.AssetName</div>
                                        <small class="text-muted fs-7">@item.AssetCode</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.EmployeeName</div>
                                        <small class="text-muted fs-7">@item.EmployeeCode</small>
                                    </td>
                                    <td><small class="text-muted">@item.AssignedDate.ToString("yyyy-MM-dd")</small></td>
                                    <td>
                                        @if (item.IsActive == true)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2 py-1">Returned</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small my-3">No recent asset assignments found.</p>
            }
        </div>
    </div>

    <!-- Recently Added Employees -->
    <div class="col-12 col-xl-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-person-plus me-2 text-primary"></i>Recently Added Employees</h5>
                <a asp-controller="Employees" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">View All</a>
            </div>
            @if (Model.RecentlyAddedEmployees != null && Model.RecentlyAddedEmployees.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Code & Name</th>
                                <th>Department</th>
                                <th>Location</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Model.RecentlyAddedEmployees)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark">@emp.EmployeeName</div>
                                        <small class="text-muted fs-7">@emp.EmployeeCode</small>
                                    </td>
                                    <td><small class="text-muted">@emp.Department</small></td>
                                    <td><small class="text-muted">@(emp.Location ?? "N/A")</small></td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1">@emp.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small my-3">No recent employees found.</p>
            }
        </div>
    </div>
</div>
